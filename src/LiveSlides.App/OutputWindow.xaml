<Window x:Class="LiveSlides.App.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveSlides — uscita"
        Icon="/Assets/LiveSlides.ico"
        Background="Black"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- No AllowsTransparency: a layered window is drawn in software, too slow for a 4K output. -->
    <Grid Background="Black">
        <!-- Two stacked layers: the slide on air stays on LayerA while the next one fades in on
             LayerB, so there is never a black frame between two slides. -->
        <Image x:Name="LayerA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="LayerB" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
